# Free-tier Finnhub API key: https://finnhub.io/register
FINNHUB_API_KEY=

PORT=8091

# Cache TTL for quote/fundamentals responses, in seconds (60-120 recommended)
CACHE_TTL_SECONDS=90

# Simple per-IP rate limit for this service's own endpoints
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
